# syntax=docker/dockerfile:1
FROM python:3.11-slim

# Set environment variables for headless Streamlit execution
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8501 \
    API_BASE_URL="http://api:8000"

WORKDIR /app

# Install project dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code, configurations, models, reports, and processed data
COPY src/ ./src/
COPY config/ ./config/
COPY models/ ./models/
COPY reports/ ./reports/
COPY data/processed/ ./data/processed/

# Expose Streamlit dashboard port
EXPOSE 8501

# Streamlit built-in health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health')"

# Run Streamlit frontend dashboard
CMD ["streamlit", "run", "src/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]

